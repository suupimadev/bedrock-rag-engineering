# このファイルはテンプレートです。実際の値を入れたファイルは ".env" として保存し、
# 絶対にコミットしないでください（.gitignoreで除外済み）。

# ==== AWS ====
AWS_REGION=ap-northeast-1

# Dockerコンテナには長期アクセスキーを渡しません。
# SSOログイン済みのプロファイルから、以下のコマンドで短期的なSTS認証情報を発行し、
# 出力された3行をこのファイルの該当箇所にそのまま貼り付けてください（有効期限が切れたら再実行）。
#   aws sso login --profile <プロファイル名>
#   aws configure export-credentials --profile <プロファイル名> --format env-no-export
AWS_ACCESS_KEY_ID=dummy-access-key-id
AWS_SECRET_ACCESS_KEY=dummy-secret-access-key
AWS_SESSION_TOKEN=dummy-session-token

# ==== Amazon Bedrock ====
# Claudeモデルは東京リージョンでは推論プロファイル経由の呼び出しが必要です
# (aws bedrock list-inference-profiles --region ap-northeast-1 で確認可能)
BEDROCK_MODEL_ID=jp.anthropic.claude-haiku-5-5
BEDROCK_MAX_TOKENS=512
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_KNOWLEDGE_BASE_ID=dummy-kb-id

# ==== RAG / Vector Store ====
VECTOR_STORE_ENDPOINT=https://dummy-vector-store.example.com
VECTOR_STORE_INDEX_NAME=dummy-index

# ==== アプリケーション ====
APP_ENV=development
LOG_LEVEL=INFO
